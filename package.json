{
  "name": "skillport",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/sync-skills.mjs --ensure",
    "dev": "vite",
    "prebuild": "node scripts/sync-skills.mjs --ensure",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "skills:sync": "node scripts/sync-skills.mjs",
    "mcp:dev": "wrangler dev --config mcp/wrangler.jsonc --port 8787",
    "mcp:deploy": "npm run skills:sync && wrangler deploy --config mcp/wrangler.jsonc",
    "mcp:typecheck": "tsc -p mcp/tsconfig.json",
    "deploy:cf": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.0",
    "wrangler": "^4.40.0"
  }
}
